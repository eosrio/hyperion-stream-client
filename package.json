{
  "name": "@eosrio/hyperion-stream-client",
  "version": "4.0.0-rc.3",
  "description": "Streaming Client for Hyperion History",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "files": ["lib/esm/*.js", "lib/esm/*.d.ts", "lib/cjs/*.js", "lib/cjs/*.d.ts", "lib/cjs/package.json", "dist/hyperion-stream-client.js", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "import": {"types": "./lib/esm/index.d.ts", "default": "./lib/esm/index.js"},
      "require": {"types": "./lib/cjs/index.d.ts", "default": "./lib/cjs/index.js"}
    },
    "./esm": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./cjs": {
      "types": "./lib/cjs/index.d.ts",
      "require": "./lib/cjs/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "bun check -p tsconfig.json",
    "build": "npm run build:all",
    "build:esm": "tsc",
    "build:esm:watch": "tsc --watch",
    "build:cjs": "node scripts/build-commonjs.mjs",
    "build:webpack": "webpack",
    "build:webpack:watch": "webpack --watch",
    "build:all": "npm run build:esm && npm run build:cjs && npm run build:webpack",
    "fix-hybrid-packages": "node scripts/create-dist-packages.mjs",
    "example:advanced-filtering": "tsx src/examples/advanced-filtering.ts",
    "generate-docs": "node scripts/generate-documentation.mjs",
    "pretest": "npm run build:all",
    "prepack": "npm run build:all",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=88 --test-coverage-functions=90 --test-coverage-include=lib/esm/*.js --test-coverage-exclude=lib/esm/examples/** test/index.js",
    "test:watch": "node --test --watch test/index.js",
    "test:cjs": "node --test test/index-cjs.js",
    "test:package": "node scripts/verify-package.mjs",
    "test:browser": "node --test test/browser.test.mjs",
    "test:connection": "node --test test/connection.test.js",
    "test:streaming": "node --test test/streaming.test.js",
    "test:error-handling": "node --test test/error-handling.test.js",
    "test:api": "node --test test/api.test.js",
    "serve:tests": "node test/browser/serve-tests.cjs"
  },
  "repository": "eosrio/hyperion-stream-client",
  "author": {
    "name": "EOS Rio",
    "url": "https://eosrio.io"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3"
  },
  "bugs": {
    "url": "https://github.com/eosrio/hyperion-stream-client/issues"
  },
  "homepage": "https://github.com/eosrio/hyperion-stream-client#readme"
}
